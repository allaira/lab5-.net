<Window x:Class="lab_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автомобільна відомість" Height="620" Width="860"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#FAFAFA">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Додати / редагувати автомобіль" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Рядок 0 -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Марка:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox x:Name="BrandTextBox" Grid.Row="0" Grid.Column="1" Margin="4" Padding="4"/>

                    <Label Grid.Row="0" Grid.Column="2" Content="Власник:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox x:Name="OwnerTextBox" Grid.Row="0" Grid.Column="3" Margin="4" Padding="4"/>

                    <!-- Рядок 1 -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Рік придбання:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox x:Name="YearTextBox" Grid.Row="1" Grid.Column="1" Margin="4" Padding="4"/>

                    <Label Grid.Row="1" Grid.Column="2" Content="Пробіг (км):" VerticalAlignment="Center" Margin="4"/>
                    <TextBox x:Name="MileageTextBox" Grid.Row="1" Grid.Column="3" Margin="4" Padding="4"/>
                </Grid>

                <Button x:Name="AddButton" Content="Додати автомобіль" Height="30" Margin="4,8,4,0" 
                        Background="#1976D2" Foreground="White" FontWeight="SemiBold" Click="AddButton_Click"/>
            </StackPanel>
        </Border>


        <DataGrid x:Name="CarsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Margin="0,0,0,10" Background="White" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Марка автомобіля" Binding="{Binding Brand}" Width="*"/>
                <DataGridTextColumn Header="Прізвище власника" Binding="{Binding Owner}" Width="*"/>
                <DataGridTextColumn Header="Рік придбання" Binding="{Binding Year}" Width="130"/>
                <DataGridTextColumn Header="Пробіг (км)" Binding="{Binding Mileage}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>


        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Фільтрувати раніше року:" VerticalAlignment="Center" Margin="4"/>
                <TextBox x:Name="FilterYearTextBox" Width="65" Margin="4" Padding="3" VerticalAlignment="Center"/>
                <Button Content="Фільтр" Margin="4" Padding="10,5" Click="FilterButton_Click"/>
                <Button Content="Скинути фільтр" Margin="4" Padding="10,5" Click="ResetFilterButton_Click"/>
                <Button Content="Видалити" Margin="4" Padding="10,5" Click="DeleteButton_Click"/>
                <Button Content="Сортувати за пробігом" Margin="4" Padding="10,5" FontWeight="SemiBold" Click="SortByMileageButton_Click"/>
                <Button Content="Завантажити" Margin="4" Padding="10,5" Click="LoadButton_Click"/>
                <Button Content="Зберегти" Margin="4" Padding="10,5" Background="#388E3C" Foreground="White" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>